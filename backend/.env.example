APP_ENV=development
REDIS_URL=redis://localhost:6379/0
PORT=8080
LAN_HOST=192.168.1.X
JWT_SECRET=replace-with-at-least-32-random-characters
PRICE_PER_KM=200
MAX_UPLOAD_MB=10

# Server-side only. Enable Places API (New), Geocoding API and Routes API.
# Never copy this key into either Expo application.
GOOGLE_MAPS_SERVER_API_KEY=

# Admin panel kimliği mobil uygulama kimliklerinden tamamen ayrıdır.
# Production'da ADMIN_PASSWORD yerine Argon2id ADMIN_PASSWORD_HASH tercih edin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
