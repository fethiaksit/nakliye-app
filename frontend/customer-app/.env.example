# The client strips a trailing /api so both URL forms work.
EXPO_PUBLIC_API_URL=http://192.168.1.X:8080/api

# Native mobile SDK keys only. Do not put GOOGLE_MAPS_SERVER_API_KEY here.
# Restrict Android to com.nakliyego.customer and iOS to com.nakliyego.customer.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
