  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx --yes --package=node@20.20.2 node ./node_modules/expo/bin/cli start --dev-client",
    "start:go": "npx --yes --package=node@20.20.2 node ./node_modules/expo/bin/cli start --go",
    "start:dev-client": "npx --yes --package=node@20.20.2 node ./node_modules/expo/bin/cli start --dev-client",
    "ios": "npx --yes --package=node@20.20.2 node ./node_modules/expo/bin/cli run:ios",
    "android": "npx --yes --package=node@20.20.2 node ./node_modules/expo/bin/cli run:android",
    "test": "node --test src/utils/*.test.cjs",
    "clean:appledouble": "bash ../../scripts/clean-appledouble.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "axios": "^1.19.0",
    "expo": "~54.0.37",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0"
