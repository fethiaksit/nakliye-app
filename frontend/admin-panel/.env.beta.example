# NakliyeGo Admin Panel Beta Environment Template
# Copy this file to .env.beta on the target host before deploying:
# cp .env.beta.example .env.beta

# Target Beta API endpoint (accessible from browser / reverse proxy)
NEXT_PUBLIC_ADMIN_API_URL=https://beta-api-18-157-76-136.sslip.io/api/admin
NEXT_PUBLIC_API_URL=https://beta-api-18-157-76-136.sslip.io

# Local/SSH tunnel fallback example:
# NEXT_PUBLIC_ADMIN_API_URL=http://127.0.0.1:8081/api/admin
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8081

# Telemetry (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Container runtime settings
PORT=3000
HOSTNAME=0.0.0.0
NODE_OPTIONS=--max-old-space-size=384

# SECURITY NOTICE:
# Admin credentials (email/password/JWT secrets) are handled exclusively by the backend API.
# Never store database passwords or JWT signing keys in this frontend environment file.
