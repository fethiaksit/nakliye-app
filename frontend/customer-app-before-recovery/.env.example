# The client strips a trailing /api so both URL forms work.
EXPO_PUBLIC_API_URL=http://192.168.111.21:8080/api

# Public mobile SDK keys only. Do not put GOOGLE_MAPS_SERVER_API_KEY here.
# Restrict Android to com.nakliyego.customer and iOS to com.nakliyego.customer.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=your_android_maps_key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=your_ios_maps_key
