EXPO_PUBLIC_API_URL=http://192.168.1.X:8080/api

# Native mobile SDK keys only. Restrict Android to com.nakliyego.driver and
# iOS to com.nakliyego.driver; never use the server Places/Routes key here.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Sentry Monitoring & Crash Reporting
EXPO_PUBLIC_SENTRY_DSN=

# PostHog Analytics & Feature Flags
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
